  "publicEntry": {
    "mode": "space-email-gate",
    "path": "/site/:configId",
    "component": "components/EmailGate.tsx"
  },
  "apps": [
    {
      "id": "loan-check",
      "name": "Loan Check",
      "icon": "Calculator",
      "description": "Loanley's whole product, as a conversation. Say what you need — 'I want a loan', 'loan chahiye', 'best loan offer' — and the chat collects six criteria (loan type, amount, tenure, employment, monthly income, CIBIL range), filters every published Indian lender against your eligibility, and answers inline: a best-match verdict with EMI, total cost, effective cost and the official rate-card citation, the full ranked list of lenders you qualify for, and a plain 'likely out of reach' section with the reason per lender. Also runs the server-computed reality-check on an offer you already have. No lender pays for placement, no Apply Now, and nothing ever routes you out of the conversation.",
      "component": "apps/LoanCheck/App.tsx"
    }
  ],
  "agent": {
    "name": "Loanley Guide",
    "welcomeMessage": "Namaste — I'm Loanley Guide. Paste your loan offer or ask any loan question. I run the real maths, tell you plainly if it's normal for India, and show my sources. I can also compare every major bank and NBFC's published rates for your profile — no lender pays to be listed, and I never sell you one.",
    "starterPrompts": [
      "Is 18% on a personal loan normal?",
      "I have an offer from HDFC",
      "₹5 lakh at 14% for 4 years, ₹6,000 fee — is this good?",
      "Which lender is cheapest for my profile?",
      "Fixed vs floating — what's the difference?"
    ]
  },
  "terminology": {
    "reading": "loading",
    "writing": "saving",
    "creating": "adding",
    "deleting": "removing",
    "editing": "updating"
  },
